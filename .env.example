# =====================================
# InkFlow AI - Environment Configuration
# =====================================

# Google Gemini API
GOOGLE_API_KEY=your_google_gemini_api_key

# Tavily Search API
TAVILY_API_KEY=your_tavily_api_key

# Authentication / JWT
AUTH_SECRET_KEY=replace_with_a_secure_random_secret

# PostgreSQL Database
DB_USER=postgres
DB_PASSWORD=your_postgresql_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inkflow_db
